# ─── DATABASE ──────────────────────────────────────────────
POSTGRES_PASSWORD=your_secure_db_password

# ─── AUTHENTICATION ─────────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_that_is_at_least_32_bytes_long

# ─── SHARED INFRASTRUCTURE (Ops Config) ─────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka-shared:9092
REDIS_CONNECTION_STRING=redis-shared:6379

# ─── NOTIFICATION WORKER ────────────────────────────────────
MAIL_APP_PASSWORD=your_gmail_app_password

# ─── AI SERVICE ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id